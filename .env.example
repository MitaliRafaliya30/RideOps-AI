# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (master data source)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rideops_ai_db
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# Azure Event Hubs
EVENT_HUBS_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<policy>;SharedAccessKey=<key>
EVENT_HUBS_HUB_NAME=ride-events

# Simulation
SIMULATOR_SEED=
SIMULATOR_LOG_LEVEL=INFO

# Databricks (only for publishing the safety model: python -m ml.serving --target databricks)
# Token: Databricks > Settings > Developer > Access tokens
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token>
