# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# Environment variables and secrets (keep only .env.example files)
.env
**/.env
secrets.env

# Large source data (download separately, see README)
data/fhvhv/
*.parquet
# Generated geo reference data (rebuild with python -m geodata.build_zones / build_road_network)
data/reference/
# Simulator backfill output (regenerate with python -m simulation.run backfill)
data/backfill/
# Local feature cache (rebuild with python -m ml.build_features)
data/features/
# OSMnx download cache
cache/

# Raw Databricks export kept locally as a backup; clean code lives in databricks/
transformations/
# Ad-hoc Databricks exploration notebooks (local only)
databricks/explorations/

# Power BI project: per-user settings and local model cache
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Logs and generated output
logs/*
!logs/.gitkeep
output/*
!output/.gitkeep

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db
