model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["agg_driver_daily","agg_revenue_daily","agg_zone_hourly","dim_cancellation_reason","dim_date","dim_driver","dim_passenger","dim_payment_method","dim_ride_status","dim_vehicle","dim_zone","fact_fhvhv_trip","fact_ride","fact_ride_event","dq_defect_scorecard","dq_all_quarantine","dq_check_results","safety_window_scores","ml_model_performance","agg_safety_hourly","fact_safety_alert","fact_ride_safety","dim_incident_type"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table agg_driver_daily
ref table agg_revenue_daily
ref table agg_zone_hourly
ref table dim_cancellation_reason
ref table dim_date
ref table dim_driver
ref table dim_passenger
ref table dim_payment_method
ref table dim_ride_status
ref table dim_vehicle
ref table dim_zone
ref table fact_fhvhv_trip
ref table fact_ride
ref table fact_ride_event
ref table _Measures
