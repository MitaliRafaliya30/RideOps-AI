table _Measures
	lineageTag: a370c588-00c0-476c-ac45-ed828398c5e5

	measure 'Total Rides' = CALCULATE(COUNT(fact_ride[ride_id]))
		lineageTag: 8fce27e3-0eef-4eb3-baaa-669d5ca78c78

	measure 'Completed Rides' = CALCULATE([Total Rides], fact_ride[final_status] = "completed")
		lineageTag: fbfba02e-c97e-40c9-b3e5-e5a9fd2981e6

	measure 'Cancelled Rides' = CALCULATE([Total Rides], fact_ride[final_status] = "cancelled")
		lineageTag: 9cdf6e39-8843-4935-a90a-4d09dcb096f2

	measure 'Completion Rate' = DIVIDE([Completed Rides], [Total Rides])
		formatString: 0.00%
		lineageTag: 55c38ca4-9adc-4988-9950-32d49f58a5fc

	measure 'Completion Rate (Settled)' = DIVIDE([Completed Rides], [Completed Rides] + [Cancelled Rides])
		formatString: 0.00%
		lineageTag: 70ea652d-14e3-4d99-900d-274870bfdf83

	measure 'Cancellation Rate' = DIVIDE([Cancelled Rides], [Total Rides])
		formatString: 0.00%
		lineageTag: 16c27050-a3cc-4dc2-9554-9f0f804363c7

	measure 'Avg Wait Time (min)' = AVERAGE(fact_ride[wait_time_sec]) / 60
		formatString: 0.00
		lineageTag: 1e1dbbb0-abcd-4fe8-bf39-6e9ce58d3526

	measure 'Total Revenue' = CALCULATE(SUM(fact_ride[total_fare]), fact_ride[final_status] = "completed")
		formatString: $#,##0.00
		lineageTag: 6a4c74cc-08a0-4840-a03e-b6b0ea86387d

	measure 'Avg Fare' = DIVIDE([Total Revenue], [Completed Rides])
		formatString: $#,##0.00
		lineageTag: 106c5e24-be93-462d-821c-32a885bd6bf5

	measure 'Total Driver Pay' = CALCULATE(SUM(fact_ride[driver_pay]), fact_ride[final_status] = "completed")
		formatString: $#,##0.00
		lineageTag: 96f9a4eb-7add-41bc-9b8a-b9310512134a

	measure 'Trips (by Source)' = SUM(agg_zone_hourly[trip_count])
		lineageTag: d706f8e5-7e0d-4373-aaa6-cc69b35d9000

	measure 'Revenue (by Source)' = SUM(agg_revenue_daily[total_revenue])
		formatString: $#,##0.00
		lineageTag: 25e62b47-9f88-446d-b27b-1a0d2bb4e5d7

	measure 'Driver Total Earnings' = SUM(agg_driver_daily[total_earnings])
		formatString: $#,##0.00
		lineageTag: 07ec24f4-2115-4e50-91d1-d943077dcb72

	measure 'Driver Completion Rate' = DIVIDE(SUM(agg_driver_daily[completed_rides]), SUM(agg_driver_daily[total_rides]))
		formatString: 0.00%
		lineageTag: e0bdcb20-0f31-49ee-be4f-a18f1af61829

	measure 'Total Cancellations' = CALCULATE(COUNT(fact_ride[ride_id]), fact_ride[final_status] = "cancelled")
		formatString: #,##0
		lineageTag: 38fb8f51-d44a-4632-a81c-28ac94aa93e5

	measure 'Most Common Cancellation Stage' = CALCULATE(MAXX(TOPN(1, VALUES(fact_ride[cancellation_stage]), CALCULATE(COUNT(fact_ride[ride_id])), DESC), fact_ride[cancellation_stage]), fact_ride[final_status] = "cancelled")
		lineageTag: 414b9546-532b-4fd8-8647-bff10c97d598

	measure 'Total Active Drivers' = DISTINCTCOUNT(agg_driver_daily[driver_key])
		formatString: #,##0
		lineageTag: 754f7a7c-737f-4225-b72d-aab3cd13e6d4

	measure 'Avg Completion Rate (Driver)' = AVERAGE(agg_driver_daily[completion_rate])
		formatString: 0.00%
		lineageTag: 41df5c47-d8f6-4262-a3a4-7a2014f809c6

	measure 'Avg Earnings per Driver' = DIVIDE(SUM(agg_driver_daily[total_earnings]), DISTINCTCOUNT(agg_driver_daily[driver_key]))
		formatString: $#,##0.00
		lineageTag: 1fe93b75-1b79-4d20-a55f-fc717660be92

	measure 'Operational Trips' = CALCULATE(SUM(agg_zone_hourly[trip_count]), agg_zone_hourly[source] = "operational")
		formatString: #,##0
		lineageTag: 91f40ae4-ba3a-4f62-997b-6508c41bbc13

	measure 'Historical Trips' = CALCULATE(SUM(agg_zone_hourly[trip_count]), agg_zone_hourly[source] = "fhvhv")
		formatString: #,##0
		lineageTag: c7254456-d124-4180-a34b-4b1f8cafa9fc

	measure 'Operational Revenue' = CALCULATE(SUM(agg_revenue_daily[total_revenue]), agg_revenue_daily[source] = "operational")
		formatString: $#,##0.00
		lineageTag: e3ac2703-ba81-484c-88ca-034a2f4d167b

	measure 'Historical Revenue' = CALCULATE(SUM(agg_revenue_daily[total_revenue]), agg_revenue_daily[source] = "fhvhv")
		formatString: $#,##0.00
		lineageTag: c7a0a724-2b18-4b4d-ba5b-0838ef16bedc

	measure 'Total Defects Measured' = CALCULATE(COUNT(dq_defect_scorecard[defect_id]))
		formatString: #,##0
		lineageTag: 6f34575b-2764-464c-b5c9-c1f6ebc6fc39

	measure 'Total Quarantined Records' = COALESCE(CALCULATE(COUNT(dq_all_quarantine[source_table])), 0)
		formatString: #,##0
		lineageTag: 5bc8d93f-416c-4425-9f58-4e70289f7fcf

	measure 'Arrived-Stage Cancellations' = CALCULATE(COUNT(fact_ride[ride_id]), fact_ride[cancellation_stage] = "arrived")
		formatString: #,##0
		lineageTag: 23203878-4fe5-4096-94f4-30d8fe92da14

	measure 'Rides Tracked' = COUNTROWS(fact_ride_safety)
		formatString: #,##0
		displayFolder: Safety
		lineageTag: ecbd5bfb-be20-4662-995b-03235334aa89

	measure 'Alerted Rides' = CALCULATE([Rides Tracked], fact_ride_safety[has_alert] = TRUE())
		formatString: #,##0
		displayFolder: Safety
		lineageTag: 32d0f1fa-2a0c-4bc1-9e4e-4d35c520b611

	measure 'Alerted Rides per 1k' = DIVIDE([Alerted Rides], [Rides Tracked]) * 1000
		formatString: 0.0
		displayFolder: Safety
		lineageTag: 3f603fbf-0482-4e5a-b78b-3d71c6aac52d

	measure 'Safety Alerts' = COUNTROWS(fact_safety_alert)
		formatString: #,##0
		displayFolder: Safety
		lineageTag: 48239468-aeaa-4c29-9287-067ff4e9de8a

	measure 'High Severity Alerts' = CALCULATE([Safety Alerts], dim_incident_type[severity] = "high")
		formatString: #,##0
		displayFolder: Safety
		lineageTag: f85044a6-7f28-428a-9dbb-8d67c6ed59db

	measure 'Avg Minutes to First Alert' = AVERAGE(fact_ride_safety[minutes_to_first_alert])
		formatString: 0.0
		displayFolder: Safety
		lineageTag: 4434eb9e-31ee-4b6e-a869-aa448d244b3a

	measure 'Avg Max Risk' = AVERAGE(fact_ride_safety[max_risk_score])
		formatString: 0.000
		displayFolder: Safety
		lineageTag: b8f8acc6-82c7-40da-b907-ac9ac34665f0

	measure 'Risk Score' = MAX(safety_window_scores[risk_score])
		formatString: 0.000
		displayFolder: Safety
		lineageTag: 1b5c91dd-e6f7-47ea-99a7-cc1892890c51

	measure 'Alerts (Hourly Mart)' = SUM(agg_safety_hourly[alerted_rides])
		formatString: #,##0
		displayFolder: Safety
		lineageTag: e409798e-f21c-4588-a999-3295805b2c58

	measure 'Alerted Rides per 1k (Hourly Mart)' = DIVIDE(SUM(agg_safety_hourly[alerted_rides]), SUM(agg_safety_hourly[rides_tracked])) * 1000
		formatString: 0.0
		displayFolder: Safety
		lineageTag: 21791e51-10e2-4579-94c6-21fbaa3d0dff

	measure 'Incidents (Ground Truth)' = CALCULATE([Rides Tracked], fact_ride_safety[has_ground_truth] = TRUE(), NOT ISBLANK(fact_ride_safety[true_incident_type]))
		formatString: #,##0
		displayFolder: Model
		lineageTag: 3a06d688-d803-48dd-bca1-efd7718abe7d

	measure 'Incidents Caught' = CALCULATE([Rides Tracked], fact_ride_safety[outcome] = "caught")
		formatString: #,##0
		displayFolder: Model
		lineageTag: 361e1a50-3b76-4386-a7a4-9d07f24c045a

	measure 'Incidents Missed' = CALCULATE([Rides Tracked], fact_ride_safety[outcome] = "missed")
		formatString: #,##0
		displayFolder: Model
		lineageTag: 99bdd2cc-9dd2-40d0-9648-99aaa44a56f1

	measure 'False Alarm Rides' = CALCULATE([Rides Tracked], fact_ride_safety[false_alarm] = TRUE())
		formatString: #,##0
		displayFolder: Model
		lineageTag: 0ffbdf48-d1ac-4deb-9ef9-84400a4f0ba5

	measure Recall = DIVIDE([Incidents Caught], [Incidents (Ground Truth)])
		formatString: 0.0%
		displayFolder: Model
		lineageTag: c5e7eb56-2946-4286-b9e7-a3e7eabeceda

	measure Precision = DIVIDE([Incidents Caught], CALCULATE([Alerted Rides], fact_ride_safety[has_ground_truth] = TRUE()))
		formatString: 0.0%
		displayFolder: Model
		lineageTag: 0a4ec292-5e07-4dc8-8a1b-a3cc84b17d81

	measure 'False Alarms per 1k' = DIVIDE([False Alarm Rides], CALCULATE([Rides Tracked], fact_ride_safety[has_ground_truth] = TRUE())) * 1000
		formatString: 0.00
		displayFolder: Model
		lineageTag: 721a0b0d-1695-4d89-a1b9-0cc69249b193

	measure 'Avg Detection Delay (min)' = CALCULATE(AVERAGE(fact_ride_safety[detection_delay_s]), fact_ride_safety[outcome] = "caught") / 60
		formatString: 0.0
		displayFolder: Model
		lineageTag: 07e8ecf9-92cf-4642-8fa2-9dea5c3dd4d4

	measure 'Daily Recall' = CALCULATE(DIVIDE(SUM(ml_model_performance[caught]), SUM(ml_model_performance[incidents])), ml_model_performance[has_ground_truth] = TRUE())
		formatString: 0.0%
		displayFolder: Model
		lineageTag: 7d1a497f-8874-4d22-9560-af488d3dbb0e

	measure 'Daily False Alarms per 1k' = CALCULATE(DIVIDE(SUM(ml_model_performance[false_alarm_rides]), SUM(ml_model_performance[rides])) * 1000, ml_model_performance[has_ground_truth] = TRUE())
		formatString: 0.00
		displayFolder: Model
		lineageTag: 4ed9b24f-89cd-4f6b-b78b-c059ed5b92c8

	measure 'DQ Last Run' = CALCULATE(MAX(dq_check_results[checked_at]), ALL(dq_check_results))
		formatString: dd MMM HH:mm
		displayFolder: Data Quality
		lineageTag: a5b9dc00-2b29-413e-a451-6a87ba225363

	measure 'DQ Checks (Last Run)' = VAR last = CALCULATE(MAX(dq_check_results[checked_at]), ALL(dq_check_results)) RETURN CALCULATE(COUNTROWS(dq_check_results), dq_check_results[checked_at] = last)
		formatString: #,##0
		displayFolder: Data Quality
		lineageTag: 5b446123-98df-40f1-9a25-4d8522afe65b

	measure 'DQ Passed (Last Run)' = VAR last = CALCULATE(MAX(dq_check_results[checked_at]), ALL(dq_check_results)) RETURN CALCULATE(COUNTROWS(dq_check_results), dq_check_results[checked_at] = last, dq_check_results[status] = "pass") + 0
		formatString: #,##0
		displayFolder: Data Quality
		lineageTag: 0a58335f-e006-4f6e-a013-6c71878521b7

	measure 'DQ Warnings (Last Run)' = VAR last = CALCULATE(MAX(dq_check_results[checked_at]), ALL(dq_check_results)) RETURN CALCULATE(COUNTROWS(dq_check_results), dq_check_results[checked_at] = last, dq_check_results[status] = "warn") + 0
		formatString: #,##0
		displayFolder: Data Quality
		lineageTag: d0bfa65f-886c-4410-bdfe-29bc7454ec18

	measure 'DQ Failures (Last Run)' = VAR last = CALCULATE(MAX(dq_check_results[checked_at]), ALL(dq_check_results)) RETURN CALCULATE(COUNTROWS(dq_check_results), dq_check_results[checked_at] = last, dq_check_results[status] = "fail") + 0
		formatString: #,##0
		displayFolder: Data Quality
		lineageTag: 6576a877-18fa-4f27-bfdc-f74919b42ed8

	measure 'DQ Skipped (Last Run)' = VAR last = CALCULATE(MAX(dq_check_results[checked_at]), ALL(dq_check_results)) RETURN CALCULATE(COUNTROWS(dq_check_results), dq_check_results[checked_at] = last, dq_check_results[status] = "skipped") + 0
		formatString: #,##0
		displayFolder: Data Quality
		lineageTag: 6da7791e-31a4-4309-ad19-4075e94f1816

	measure 'DQ Pass Rate (Last Run)' = DIVIDE([DQ Passed (Last Run)], [DQ Checks (Last Run)] - [DQ Skipped (Last Run)])
		formatString: 0.0%
		displayFolder: Data Quality
		lineageTag: 7bc0009a-f28a-412c-abc6-4e8208fc08a9

	measure 'DQ Checks' = COUNTROWS(dq_check_results)
		formatString: #,##0
		displayFolder: Data Quality
		lineageTag: 9ae1d3a0-5e08-4090-b7ea-e123cca94fd7

	measure 'Alerts on Ride' = COALESCE([Safety Alerts], 0)
		formatString: 0
		displayFolder: Safety
		lineageTag: 4a641479-ae69-41c4-8583-1c2d0698857e

	measure 'First Alert (min)' = IF(ISBLANK([Avg Minutes to First Alert]), "no alert", FORMAT([Avg Minutes to First Alert], "0.0"))
		displayFolder: Safety
		lineageTag: 11504a87-0d70-4926-ad03-d80e58446499

	measure 'Bronze Contract Violations' = CALCULATE(SUM(dq_defect_scorecard[count]), dq_defect_scorecard[defect_id] IN {5, 6, 7})
		formatString: #,##0
		displayFolder: Data Quality
		lineageTag: da050101-9474-42c1-8981-bdb7ec6e1465

	column Value
		isHidden
		lineageTag: 6203282b-9b96-4ac3-b2f1-9c8c4b29e9f2
		isNameInferred
		sourceColumn: [Value]

	partition _Measures = calculated
		mode: import
		source = ROW("Value", BLANK())

