                                                    "value": "@item()",
                                                    "type": "Expression"
                                                }
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    }
                ],
                "policy": {
                    "elapsedTimeMetric": {}
                },
                "parameters": {
                    "tables": {
                        "type": "array",
                        "defaultValue": [
                            "drivers",
                            "membership_tiers",
                            "passengers",
                            "payment_methods",
                            "ride_status",
                            "vehicle_types",
                            "vehicles",
                            "zone_lookup",
                            "cancellation_reasons"
                        ]
                    }
                },
                "annotations": [],
                "lastPublishTime": "2026-08-23T18:40:15Z"
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/datasets/ds_postgres_rideops')]",
                "[concat(variables('factoryId'), '/datasets/ds_adls_reference')]"
            ]
        },
