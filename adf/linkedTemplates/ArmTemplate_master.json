        "ls_postgres_rideops_ai_db_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'ls_postgres_rideops_ai_db'"
        },
        "LS_SRC_LOCAL_SIM_password": {
            "type": "secureString",
            "metadata": "Secure string for 'password' of 'LS_SRC_LOCAL_SIM'"
        },
        "LS_SRC_LOCAL_FHVHV_properties_typeProperties_host": {
            "type": "string",
            "defaultValue": "C:\\Users\\win-11\\Desktop\\Data Engineering\\RideOps-AI\\data\\fhvhv"
        },
        "LS_SRC_LOCAL_FHVHV_properties_typeProperties_userId": {
            "type": "string",
            "defaultValue": "meet\\win-11"
        },
        "LS_ADLS_RIDEOPS_properties_typeProperties_url": {
            "type": "string",
            "defaultValue": "https://strideopsdev1.dfs.core.windows.net/"
