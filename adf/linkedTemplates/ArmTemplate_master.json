                    },
                    "ls_postgres_rideops_ai_db_password": {
                        "value": "[parameters('ls_postgres_rideops_ai_db_password')]"
                    },
                    "LS_SRC_LOCAL_SIM_password": {
                        "value": "[parameters('LS_SRC_LOCAL_SIM_password')]"
                    },
                    "LS_SRC_LOCAL_FHVHV_properties_typeProperties_host": {
                        "value": "[parameters('LS_SRC_LOCAL_FHVHV_properties_typeProperties_host')]"
                    },
                    "LS_SRC_LOCAL_FHVHV_properties_typeProperties_userId": {
                        "value": "[parameters('LS_SRC_LOCAL_FHVHV_properties_typeProperties_userId')]"
                    },
                    "LS_ADLS_RIDEOPS_properties_typeProperties_url": {
                        "value": "[parameters('LS_ADLS_RIDEOPS_properties_typeProperties_url')]"
                    },
                    "ls_postgres_rideops_ai_db_properties_typeProperties_server": {
                        "value": "[parameters('ls_postgres_rideops_ai_db_properties_typeProperties_server')]"
                    },
                    "ls_postgres_rideops_ai_db_properties_typeProperties_database": {
                        "value": "[parameters('ls_postgres_rideops_ai_db_properties_typeProperties_database')]"
                    },
                    "ls_postgres_rideops_ai_db_properties_typeProperties_username": {
                        "value": "[parameters('ls_postgres_rideops_ai_db_properties_typeProperties_username')]"
                    },
                    "LS_SRC_LOCAL_SIM_properties_typeProperties_host": {
                        "value": "[parameters('LS_SRC_LOCAL_SIM_properties_typeProperties_host')]"
                    },
                    "LS_SRC_LOCAL_SIM_properties_typeProperties_userId": {
                        "value": "[parameters('LS_SRC_LOCAL_SIM_properties_typeProperties_userId')]"
                    }
                }
            },
            "dependsOn": []
